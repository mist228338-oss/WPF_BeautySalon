<Window x:Class="WPF_BeautySalon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Салон Красоты" Height="600" Width="900"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Background="#F3F3F3">
            <Button Content="Назад" Click="BtnBack_Click" Width="80" Background="#FF9918"/>
            <Button Content="Сменить тему" Click="BtnTheme_Click" Background="#233E76"/>
            <TextBlock x:Name="TbPageTitle" Text="Авторизация" FontFamily="Open Sans" FontSize="18" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#233E76"/>
        </StackPanel>

        <!-- Фрейм для страниц -->
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Source="/Pages/AuthPage.xaml"/>

        <!-- Нижняя панель -->
        <TextBlock x:Name="DateTimeNow" Grid.Row="2" HorizontalAlignment="Right" 
                   VerticalAlignment="Center" Margin="0,0,20,0" FontFamily="Open Sans"/>
    </Grid>
</Window>