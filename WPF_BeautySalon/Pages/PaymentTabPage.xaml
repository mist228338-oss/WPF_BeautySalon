<Page x:Class="WPF_BeautySalon.Pages.PaymentTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Платежи">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Таблица платежей -->
        <DataGrid Grid.Row="0" x:Name="DataGridPayments" AutoGenerateColumns="False" IsReadOnly="True" 
                  SelectionMode="Single" CanUserAddRows="False" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="90"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding User.FIO}" Width="150"/>
                <DataGridTextColumn Header="Название услуги" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="120"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Num}" Width="60"/>
                <DataGridTextColumn Header="Цена (руб)" Binding="{Binding Price}" Width="80"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Total}" Width="90"/>
                <!-- Если есть вычисляемое поле -->
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Обновить" Click="ButtonRefresh_Click" Background="#0198AF" Margin="0,0,10,0" ToolTip="Обновить таблицу"/>
            <Button Content="Удалить" Click="ButtonDel_Click" Background="IndianRed" ToolTip="Удалить выбранную запись"/>
        </StackPanel>
    </Grid>
</Page>