<Page x:Class="WPF_BeautySalon.Pages.AddCategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Категория">
    <Grid Background="#F3F3F3">
        <Border Background="White" Width="350" Padding="20" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="TbTitle" Text="Добавление категории" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                <Label Content="Название:"/>
                <TextBox x:Name="TbName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Введите название услуги"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Сохранить" Click="ButtonSave_Click" Background="#0198AF"/>
                    <Button Content="Отмена" Click="ButtonCancel_Click" Background="Gray"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>