<Page x:Class="WPF_BeautySalon.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личный кабинет">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Личный кабинет клиента" FontSize="24" FontWeight="Bold" Foreground="#233E76" Margin="0,0,0,20"/>

            <TextBlock Text="Здесь вы можете просматривать свои услуги и историю платежей." FontSize="14" Margin="0,0,0,20"/>

            <!-- Здесь в будущем можно вывести список платежей конкретного пользователя -->
            <TextBlock Text="Ваши записи:" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,10"/>

            <DataGrid x:Name="UserPaymentsGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="100"/>
                    <DataGridTextColumn Header="Услуга" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="150"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Price}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Page>