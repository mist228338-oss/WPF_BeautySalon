<Page x:Class="WPF_BeautySalon.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация">

    <Grid>
        <!-- По центру экрана -->
        <StackPanel Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="Авторизация" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#233E76"/>

            <!-- Поля логина и пароля -->
            <Label Content="Логин" FontWeight="Bold"/>
            <TextBox x:Name="TextBoxLogin" Height="30" VerticalContentAlignment="Center" ToolTip="Введите ваш логин"/>

            <Label Content="Пароль" FontWeight="Bold" Margin="0,10,0,0"/>
            <PasswordBox x:Name="PasswordBox" Height="30" VerticalContentAlignment="Center" ToolTip="Введите ваш пароль"/>

            <!-- Блок капчи (скрыт по умолчанию) -->
            <StackPanel x:Name="CaptchaPanel" Visibility="Hidden" Margin="0,15,0,0">
                <Label Content="Введите капчу:" FontWeight="Bold" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="CaptchaTextBox" Width="100" Height="30" FontWeight="Bold" IsReadOnly="True" 
                             FontStyle="Italic" FontSize="18" Foreground="Red" HorizontalContentAlignment="Center" 
                             VerticalContentAlignment="Center" Background="#F3F3F3"/>

                    <TextBox x:Name="CaptchaInput" Width="100" Height="30" Margin="10,0,0,0" 
                             VerticalContentAlignment="Center" ToolTip="Введите символы с картинки слева"/>

                    <Button Content="↻" Width="35" Height="30" Margin="10,0,0,0" Click="ButtonRefreshCaptcha_Click" ToolTip="Обновить капчу"/>
                </StackPanel>
            </StackPanel>

            <!-- Кнопки -->
            <Button x:Name="ButtonEnter" Content="Вход" Margin="0,20,0,10" Click="ButtonEnter_OnClick" ToolTip="Войти в систему"/>
            <Button x:Name="ButtonReg" Content="Регистрация" Click="ButtonReg_Click" ToolTip="Создать нового пользователя"/>

        </StackPanel>
    </Grid>
</Page>