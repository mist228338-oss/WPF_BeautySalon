<Page x:Class="WPF_BeautySalon.Pages.DiagramPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Диаграмма">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель фильтров -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Клиент:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox x:Name="CmbUser" Width="180" Height="30" Margin="5" 
                      SelectionChanged="UpdateChart" DisplayMemberPath="FIO"/>

            <Label Content="Тип графика:" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"/>
            <ComboBox x:Name="CmbDiagram" Width="130" Height="30" Margin="5" 
                      SelectionChanged="UpdateChart"/>

            <Button Content="Экспорт в Word" Click="BtnExportWord_Click" Background="#233E76" Margin="20,0,5,0"/>
            <Button Content="Экспорт в Excel" Click="BtnExportExcel_Click" Background="#0198AF"/>
        </WrapPanel>

        <!-- Контейнер для диаграммы -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Background="White">
            <Grid x:Name="ChartContainer"/>
        </Border>
    </Grid>
</Page>