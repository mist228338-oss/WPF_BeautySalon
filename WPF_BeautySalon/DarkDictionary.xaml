<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Цвета для темной темы -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="Aqua"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#FF9918"/>

    <!-- Стили (можно скопировать из Dictionary.xaml, но поменять привязки цветов на DynamicResource) -->
    <Style TargetType="Button">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}"/>
        <Setter Property="Foreground" Value="Beige"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
    </Style>
</ResourceDictionary>